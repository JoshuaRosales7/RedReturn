# --- Web (build time, public) -------------------------------------------------------------
# Base URL of the deployed RedReturn API. Never put secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- API (server side) ---------------------------------------------------------------------
# Comma-separated list of allowed browser origins (exact match).
REDRETURN_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REDRETURN_RATE_PER_MIN=600
REDRETURN_HEAVY_PER_MIN=180
REDRETURN_MAX_BODY_BYTES=200000

# Optional language-model paraphrase of calculation-based answers. Leave empty to disable.
# Both must be set; the model never supplies numbers.
OPENAI_API_KEY=
OPENAI_MODEL=
